# What to ask, ranked by how much of the province each answer unblocks.
#
# The last trip of the day is the one figure that decides whether a place is a
# day trip, and almost none of it is published. It is also cheap to collect:
# one question at a ticket booth, one call to a municipal tourism office. This
# task turns the gaps in the data into that list of questions, ordered so the
# first call is worth the most.
#
#   bin/rails last_trips:gaps          print it
#   bin/rails last_trips:gaps[write]   write data/ASK-TOURISM.md
namespace :last_trips do
  desc "List the unknown last trips, ranked by how many destinations each blocks"
  task :gaps, [ :write ] => :environment do |_task, args|
    report = LastTripGaps.new.report
    puts report

    next unless args[:write] == "write"

    path = Rails.root.parent.join("data", "ASK-TOURISM.md")
    path.write(report)
    puts "\nwritten to #{path}"
  end
end

# Walks every place, every way in, and every island a traveller might start
# from, and counts how often each hop home is one nobody can answer.
class LastTripGaps
  ORIGINS = %w[Masbate Ticao Burias Luzon].freeze

  Gap = Struct.new(:leg, :board_stop, :places, :reason, keyword_init: true) do
    def blocked = places.size
  end

  def report
    gaps = collect.values.sort_by { |gap| [ -gap.blocked, gap.leg.external_id ] }
    lines = [ header(gaps) ]

    gaps.each_with_index do |gap, index|
      lines << question(gap, index + 1)
    end

    lines << footer
    lines.join("\n")
  end

  private

  def collect
    gaps = {}
    graph = IslandConnection.new

    Place.includes(place_access_legs: { fare_leg: [ :from_stop, :to_stop, :vihicle, :routes, :last_trips ] }).find_each do |place|
      ORIGINS.each do |origin|
        FareEstimate.for_place(place, pax: 1, from_island: origin).each do |estimate|
          outbound = outbound_for(estimate, graph, origin)
          next if outbound.empty?

          result = ReturnTrip.for(outbound)
          (result.unknown_hops + result.unmodelled_hops).each do |hop|
            key = [ hop.leg.id, hop.board_stop&.id ]
            gaps[key] ||= Gap.new(leg: hop.leg, board_stop: hop.board_stop, places: Set.new,
                                  reason: reason_for(hop))
            gaps[key].places << place.name
          end
        end
      end
    end

    gaps
  end

  def outbound_for(estimate, graph, origin)
    connection = graph.between(origin, estimate.origin_island, continuing_from: estimate.legs.first&.from_stop)
    hops = []
    connection&.steps&.each { |step| hops << [ step.best.leg, step.best.origin_stop ] }
    estimate.legs.each { |leg| hops << [ leg, leg.from_stop ] }
    hops
  end

  def reason_for(hop)
    return "the leg lands nowhere the data can name, so it cannot be ridden backwards" unless hop.modelled?

    case hop.leg.schedule_kind
    when "window"    then "operating hours only - the service leaves when it fills, so the closing time is not a departure"
    when "on_demand" then "arranged on the spot, so there is no timetable to read"
    when "departures" then "there is a timetable, but it is #{hop.leg.schedule_confidence} and not trusted enough to read a last trip off"
    else "nothing published at all"
    end
  end

  def header(gaps)
    <<~MARKDOWN
      # What to ask Masbate tourism

      Generated by `bin/rails last_trips:gaps` on #{Date.current}. Regenerate it as
      answers come in.

      **The question, every time, is the same: what time does the last one leave,
      coming back?** Not the first one, and not the outbound direction — the two
      ends of a route rarely run to the same clock, and it is the return that
      strands people. The last pumpboat off Masbate City is 13:00 and the last one
      off Ticao is 14:00, and that hour is the whole difference.

      Useful to say why: this is for an offline travel guide, the figures are
      credited to the source, and a wrong one is worse than a blank.

      #{gaps.size} unanswered, ordered by how many destinations each one blocks.
      Answers go in `data/last_trips.csv`, one row per leg per boarding stop.

      ---
    MARKDOWN
  end

  def question(gap, rank)
    sample = gap.places.to_a.sort.first(4)
    more = gap.blocked > sample.size ? ", and #{gap.blocked - sample.size} more" : ""

    <<~MARKDOWN

      ### #{rank}. #{title(gap)}

      > #{ask(gap)}

      - **Blocks #{gap.blocked} destination#{"s" unless gap.blocked == 1}:** #{sample.join(", ")}#{more}
      - **Leg:** `#{gap.leg.external_id}` · **Board at:** `#{gap.board_stop&.gtfs_id || "not a fixed stop"}`
      - **Why it is missing:** #{gap.reason}
      - **Who would know:** #{who_would_know(gap)}
    MARKDOWN
  end

  def title(gap)
    mode = gap.leg.vihicle&.name || "Service"
    return "#{mode} availability late in the day, province-wide" unless gap.board_stop

    towards = gap.leg.other_end_name(gap.board_stop)
    "Last #{mode.downcase} out of #{gap.board_stop.name}#{towards ? " towards #{towards}" : ""}"
  end

  # A timetabled service has a last departure. A habal-habal does not -- it has
  # an hour after which there are none at the stand, which is a different
  # question and has to be asked as one, or the answer comes back as a guess.
  def ask(gap)
    where = gap.board_stop&.name
    case gap.leg.vihicle&.name
    when "Motorcycle", "Tricycle"
      "How late can you still find one#{where ? " at #{where}" : ""}? Is there an hour after which " \
      "the stand empties out, and is it different on a Sunday?"
    when "Ferry", "Boat"
      "What time is the last #{gap.leg.vihicle.name.downcase} out of #{where}, coming back? " \
      "Does it run every day, and does it stop earlier in the habagat?"
    else
      "What time does the last one leave #{where}, coming back? Does it run daily, " \
      "and is the last one earlier on a Sunday?"
    end
  end

  def who_would_know(gap)
    case gap.leg.vihicle&.name
    when "Ferry", "Boat" then "the shipping line's booth at the pier, or the municipal tourism office"
    when "Bus", "Van", "Mini Jeep" then "the terminal dispatcher, or the municipal transport office"
    when "Motorcycle", "Tricycle" then "the drivers' association at the stand - availability rather than a timetable"
    else "the municipal tourism office"
    end
  end

  def footer
    <<~MARKDOWN

      ---

      ## Also worth confirming while you have them

      - **`L_RORO_MOBO_SANJACINTO`** — MARINA certifies Mobo to San Jacinto as a
        served route and publishes no times for it. It is the only Masbate-island
        link to Ticao that skips Masbate City, and the app now routes Ticao–Burias
        over it, so a timetable here matters more than its traffic suggests.
      - **Aroroy to Bugui Point** — the ₱50 public boat and the ₱800 charter are
        both January 2018 figures.
      - **The Bulan–San Jacinto sailing times** — the 2017 and 2026 sources
        disagree, and MARINA records San Jacinto as daytime navigation only.
      - **Whether the Mobo–Claveria RoRo really leaves at 00:01.** It chains
        correctly with the Pio Duran leg, but it is an odd enough hour to be worth
        one confirmation.
    MARKDOWN
  end
end
